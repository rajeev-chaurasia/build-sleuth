+                    {'items': {'type': 'integer'}, 'type': 'array'},
+                ],
+                'title': 'Tc',
+            },
+            'tb': {'items': {'type': 'string'}, 'title': 'Tb', 'type': 'array'},
+            'td': {'items': {'type': 'string'}, 'title': 'Td', 'type': 'array'},
